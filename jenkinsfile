pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Master', url: 'https://github.com/vishnuofficial164/addressbook.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker buildx build -t addressbook .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d -p 8081:8080 --name addressbook_container addressbook'
            }
        }
    }
}
